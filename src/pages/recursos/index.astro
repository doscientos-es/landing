---
import { getCollection } from "astro:content";
import Breadcrumbs from "~/components/seo/Breadcrumbs.astro";
import MainLayout from "~/layouts/MainLayout.astro";
import {
  getResourceCategories,
  resourceCategories,
} from "~/shared/lib/resourceCategories";
import { getBuyerStageLabel, getResourceLabel } from "~/shared/lib/resources";
import {
  featuredResourcePicks,
  getEstimatedReadingMinutes,
  getResourceActionLabel,
  resourceJourneys,
} from "~/shared/lib/resourcePresentation";

const resources = await getCollection("blog", ({ data }) => !data.draft);
const sortedResources = resources.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);

const postsById = new Map(sortedResources.map((post) => [post.id, post]));
const featuredResources = featuredResourcePicks.flatMap((pick) => {
  const post = postsById.get(pick.slug);
  return post ? [{ ...pick, post }] : [];
});
const filters = resourceCategories.map((category) => ({
  ...category,
  count: sortedResources.filter((post) =>
    getResourceCategories(post.data.tags).some(
      ({ slug }) => slug === category.slug,
    ),
  ).length,
}));
---

<MainLayout
  title="Recursos gratis sobre automatización y software a medida | doscientos"
  description="Guías, checklists, calculadoras y artículos para detectar procesos manuales, priorizar automatizaciones y decidir qué construir primero."
>
  <div class="min-h-screen py-32 px-6">
    <div class="max-w-6xl mx-auto space-y-12">
      <Breadcrumbs items={[{ name: "Recursos", url: "/recursos" }]} />

      <header
        class="flex flex-col max-w-3xl items-center justify-center text-center gap-6 mx-auto"
      >
        <h1
          class="font-semibold text-foreground flex flex-col text-3xl md:text-5xl items-center text-center text-pretty"
        >
          <span>Herramientas y guías para decidir qué automatizar</span>
        </h1>
        <p class="text-muted-foreground max-w-2xl text-pretty">
          Contenido práctico para detectar coste oculto, comparar opciones y
          preparar una decisión antes de invertir en software.
        </p>
      </header>

      <section class="space-y-6" aria-labelledby="resource-journeys-heading">
        <div class="space-y-2">
          <h2
            id="resource-journeys-heading"
            class="text-2xl font-semibold text-foreground"
          >
            ¿Qué necesitas resolver?
          </h2>
          <p class="max-w-2xl text-muted-foreground">
            Elige un punto de partida y explora guías relacionadas con tu
            situación.
          </p>
        </div>
        <div class="grid gap-4 md:grid-cols-3">
          {
            resourceJourneys.map((journey) => (
              <a
                href={journey.href}
                class="group flex h-full flex-col gap-4 rounded-2xl border border-muted bg-secondary p-6 shadow-pastel transition-colors hover:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
              >
                <h3 class="text-xl font-semibold leading-tight text-foreground group-hover:text-primary">
                  {journey.title}
                </h3>
                <p class="text-sm leading-relaxed text-muted-foreground">
                  {journey.description}
                </p>
                <span class="mt-auto pt-2 text-sm font-semibold text-foreground">
                  {journey.linkLabel}
                  <span aria-hidden="true"> →</span>
                </span>
              </a>
            ))
          }
        </div>
      </section>

      {
        featuredResources.length > 0 && (
          <section
            class="space-y-6"
            aria-labelledby="featured-resources-heading"
          >
            <div class="space-y-2">
              <h2
                id="featured-resources-heading"
                class="text-2xl font-semibold text-foreground"
              >
                Empieza por estos recursos
              </h2>
              <p class="max-w-2xl text-muted-foreground">
                Una selección de guías para priorizar, comparar y validar antes
                de invertir.
              </p>
            </div>
            <div class="grid gap-4 md:grid-cols-3">
              {featuredResources.map(({ post, eyebrow, action }) => (
                <a
                  href={`/recursos/${post.id}?ref=recurso-destacado`}
                  class="group flex h-full flex-col gap-4 rounded-2xl border border-primary/20 bg-primary p-6 text-background shadow-pastel transition-opacity hover:opacity-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
                >
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <span class="text-xs font-semibold opacity-80">
                      {eyebrow}
                    </span>
                    <span class="text-xs opacity-80">
                      {getEstimatedReadingMinutes(post.body ?? "")} min de
                      lectura
                    </span>
                  </div>
                  <h3 class="text-xl font-bold leading-tight">
                    {post.data.title}
                    <span class="sr-only">
                      {" "}
                      — {getResourceLabel(post.data.resourceType)}
                    </span>
                  </h3>
                  <p class="text-sm leading-relaxed opacity-80">
                    {post.data.description}
                  </p>
                  <span class="mt-auto inline-flex pt-2 text-sm font-semibold group-hover:underline">
                    {action}
                    <span class="ml-2" aria-hidden="true">
                      →
                    </span>
                  </span>
                </a>
              ))}
            </div>
          </section>
        )
      }

      {
        sortedResources.length > 0 ? (
          <section class="space-y-8" aria-labelledby="resources-heading">
            <div class="space-y-4 border-b border-muted pb-6">
              <div class="flex flex-wrap items-end justify-between gap-4">
                <div class="space-y-1">
                  <h2
                    id="resources-heading"
                    class="text-2xl font-semibold text-foreground"
                  >
                    Explora todos los recursos
                  </h2>
                  <p class="text-sm text-muted-foreground">
                    Filtra por tema y elige el formato que te resulte más útil.
                  </p>
                </div>
                <p
                  id="resource-filter-status"
                  class="text-sm text-muted-foreground"
                  aria-live="polite"
                >
                  {sortedResources.length} recursos
                </p>
              </div>

              <div
                class="flex flex-wrap gap-2"
                data-resource-filters
                aria-label="Filtrar recursos por tema"
              >
                <button
                  type="button"
                  data-resource-filter="all"
                  aria-pressed="true"
                  class="rounded-full border border-primary bg-primary px-4 py-2 text-sm font-semibold text-background transition-colors"
                >
                  Todos
                </button>
                {filters.map((filter) => (
                  <button
                    type="button"
                    data-resource-filter={filter.slug}
                    aria-pressed="false"
                    class="rounded-full border border-muted bg-background px-4 py-2 text-sm font-medium text-foreground transition-colors hover:border-primary/40"
                  >
                    {filter.label}{" "}
                    <span class="opacity-70">{filter.count}</span>
                  </button>
                ))}
              </div>
            </div>

            <div class="grid gap-6 md:grid-cols-2" data-resource-grid>
              {sortedResources.map((post) => {
                const postCategories = getResourceCategories(post.data.tags);
                return (
                  <article
                    data-resource-card
                    data-resource-categories={postCategories
                      .map(({ slug }) => slug)
                      .join(" ")}
                  >
                    <a
                      href={`/recursos/${post.id}`}
                      class="group flex h-full flex-col gap-3 rounded-2xl border border-muted bg-secondary p-6 shadow-pastel transition-colors hover:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
                    >
                      <div class="flex flex-wrap items-center gap-2">
                        <span class="rounded-full border border-muted bg-background px-3 py-1 text-xs font-semibold text-foreground">
                          {getResourceLabel(post.data.resourceType)}
                        </span>
                        <span class="rounded-full bg-muted px-3 py-1 text-xs text-foreground">
                          {getBuyerStageLabel(post.data.buyerStage)}
                        </span>
                      </div>

                      <div class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
                        <time datetime={post.data.publishDate.toISOString()}>
                          {post.data.publishDate.toLocaleDateString("es-ES", {
                            year: "numeric",
                            month: "long",
                            day: "numeric",
                          })}
                        </time>
                        <span aria-hidden="true">·</span>
                        <span>
                          {getEstimatedReadingMinutes(post.body ?? "")} min de
                          lectura
                        </span>
                      </div>

                      <h3 class="text-2xl font-bold text-foreground transition-colors group-hover:text-primary">
                        {post.data.title}
                      </h3>

                      <p class="line-clamp-3 text-muted-foreground">
                        {post.data.description}
                      </p>

                      {postCategories.length > 0 && (
                        <div class="flex flex-wrap gap-2 pt-1">
                          {postCategories.slice(0, 2).map((category) => (
                            <span class="rounded-full bg-muted px-3 py-1 text-xs text-foreground">
                              {category.label}
                            </span>
                          ))}
                        </div>
                      )}

                      <span class="mt-auto inline-flex items-center gap-2 pt-4 font-medium text-foreground">
                        {getResourceActionLabel(post.data.resourceType)}
                        <svg
                          aria-hidden="true"
                          class="h-4 w-4 transition-transform group-hover:translate-x-1"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M17 8l4 4m0 0l-4 4m4-4H3"
                          />
                        </svg>
                      </span>
                    </a>
                  </article>
                );
              })}
            </div>
            <p
              hidden
              class="py-12 text-center text-muted-foreground"
              data-resource-empty
            >
              No hay recursos publicados en esta categoría todavía.
            </p>
          </section>
        ) : (
          <div class="py-20 text-center">
            <p class="text-xl text-neutral-500 dark:text-neutral-400">
              Próximamente publicaremos recursos prácticos.
            </p>
          </div>
        )
      }
    </div>
  </div>
</MainLayout>

<script>
  const filterBar = document.querySelector<HTMLElement>(
    "[data-resource-filters]",
  );

  if (filterBar && filterBar.dataset.ready !== "true") {
    filterBar.dataset.ready = "true";
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>("[data-resource-card]"),
    );
    const status = document.querySelector<HTMLElement>(
      "#resource-filter-status",
    );
    const empty = document.querySelector<HTMLElement>("[data-resource-empty]");

    filterBar.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const button = target.closest<HTMLButtonElement>(
        "[data-resource-filter]",
      );
      const selected = button?.dataset.resourceFilter;
      if (!button || !selected) return;

      let visible = 0;
      cards.forEach((card) => {
        const categories = card.dataset.resourceCategories?.split(" ") ?? [];
        const matches = selected === "all" || categories.includes(selected);
        card.hidden = !matches;
        if (matches) visible += 1;
      });

      filterBar
        .querySelectorAll<HTMLButtonElement>("[data-resource-filter]")
        .forEach((item) => {
          const active = item === button;
          item.setAttribute("aria-pressed", String(active));
          item.classList.toggle("border-primary", active);
          item.classList.toggle("bg-primary", active);
          item.classList.toggle("text-background", active);
          item.classList.toggle("border-muted", !active);
          item.classList.toggle("bg-background", !active);
          item.classList.toggle("text-foreground", !active);
        });

      if (status)
        status.textContent = `${visible} ${visible === 1 ? "recurso" : "recursos"}`;
      if (empty) empty.hidden = visible !== 0;
    });
  }
</script>
