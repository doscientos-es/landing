---
import MainLayout from "~/layouts/MainLayout.astro";
import SectionHeader from "~/components/ui/SectionHeader.astro";
---

<MainLayout
  title="Gracias por contactar | doscientos"
  description="Hemos recibido tus datos y nos pondremos en contacto contigo pronto."
>
  <section class="mx-auto flex min-h-[70vh] w-full max-w-3xl items-center px-6 py-32">
    <div class="w-full space-y-8 text-center" data-reveal="bottom">
      <SectionHeader
        title="Gracias por escribirnos"
        description="Hemos recibido tu formulario y nos pondremos en contacto contigo lo antes posible. Te hemos enviado un email de confirmación desde hola@doscientos.es; si no lo ves en unos minutos, revisa la carpeta de spam o promociones."
        align="center"
      />
      <a
        href="/"
        class="bg-primary text-background inline-flex rounded-full px-6 py-3 font-semibold transition-opacity hover:opacity-90"
      >
        Volver al inicio
      </a>
    </div>
  </section>
</MainLayout>

<script>
  import confetti from "canvas-confetti";

  confetti({ particleCount: 120, spread: 75, origin: { y: 0.6 } });
</script>
