---
import Breadcrumbs from "~/components/seo/Breadcrumbs.astro";
import changelog from "~/data/changelog.json";
import MainLayout from "~/layouts/MainLayout.astro";

const formatDate = (date: string) =>
  new Intl.DateTimeFormat("es-ES", { dateStyle: "long", timeZone: "UTC" }).format(
    new Date(`${date}T00:00:00Z`),
  );
---

<MainLayout
  title="Novedades | doscientos"
  description="Descubre las mejoras recientes de la web de doscientos."
  showFooterCta={false}
>
  <div class="mx-auto w-full max-w-5xl px-6 pt-12 md:px-10">
    <Breadcrumbs items={[{ name: "Novedades", url: "/changelog" }]} />
    <header class="mb-16 mt-10 max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-primary">Novedades de la web</p>
      <h1 class="mt-4 text-4xl font-bold tracking-tight text-foreground md:text-6xl">Lo nuevo en doscientos</h1>
      <p class="mt-5 text-lg leading-relaxed text-foreground/70">
        Un resumen claro de los cambios que hemos ido incorporando a esta web.
      </p>
    </header>
    {
      changelog.releases.length ? (
        <ol class="space-y-12" aria-label="Historial de novedades">
          {changelog.releases.map((release) => (
            <li class="rounded-3xl border border-muted bg-background p-6 shadow-pastel md:p-10">
              <article>
                <time datetime={release.date} class="text-sm font-medium text-primary">
                  {formatDate(release.date)}
                </time>
                <h2 class="mt-3 scroll-mt-28 text-2xl font-semibold text-foreground md:text-3xl">
                  {release.title}
                </h2>
                <div class="mt-8 grid gap-8 md:grid-cols-2">
                  {release.sections.map((section) => (
                    <section aria-label={section.title}>
                      <h3 class="text-lg font-semibold text-foreground">{section.title}</h3>
                      <ul class="mt-4 list-disc space-y-3 pl-5 text-foreground/75 marker:text-primary">
                        {section.items.map((item) => <li class="break-words leading-relaxed">{item}</li>)}
                      </ul>
                    </section>
                  ))}
                </div>
              </article>
            </li>
          ))}
        </ol>
      ) : (
        <p class="rounded-2xl border border-muted p-8 text-foreground/70">Pronto compartiremos novedades.</p>
      )
    }
  </div>
</MainLayout>