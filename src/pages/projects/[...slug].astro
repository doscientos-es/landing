---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import "~/styles/prose.css";
import { Layout, Timer, User } from "@lucide/astro";
import Breadcrumbs from "~/components/seo/Breadcrumbs.astro";
import SchemaOrg from "~/components/seo/SchemaOrg.astro";
import Highlight from "~/components/ui/Highlight.astro";
import Link from "~/components/ui/Link.astro";
import OtherProjects from "~/features/projects/ui/OtherProjects.astro";
import MainLayout from "~/layouts/MainLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection(
    "projects",
    ({ data }) => data.available,
  );
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

// Obtener la URL de la imagen de cover para OG
const coverImage = project.data.cover;
const publishedTime =
  project.data.endedAt instanceof Date
    ? project.data.endedAt.toISOString()
    : project.data.endedAt;

// SEO: title y meta description optimizados con fallback al contenido base
const seoTitle = project.data.seoTitle ?? `${project.data.title} | doscientos`;
const metaDescription = project.data.metaDescription ?? project.data.summary;
const timelineText =
  project.data.timelineLabel ??
  (project.data.timeline
    ? `${project.data.timeline} ${project.data.timelineUnit}${project.data.timeline === 1 ? "" : project.data.timelineUnit === "semana" ? "s" : "es"}`
    : "");
---

<MainLayout
  title={seoTitle}
  description={metaDescription}
  image={coverImage?.src}
  type="article"
  article={{
    publishedTime,
    author: "doscientos",
    tags: project.data.services_provided,
  }}
>
  <SchemaOrg
    type="project"
    project={{
      name: project.data.title,
      description: metaDescription,
      image: coverImage?.src,
      client: project.data.client,
      datePublished: publishedTime,
      url: `https://doscientos.es/projects/${project.id}`,
      services: project.data.services_provided,
    }}
  />
  <article
    class="min-h-screen py-4 lg:py-20 px-4 lg:px-6 max-w-5xl mx-auto space-y-6 lg:space-y-12"
  >
    <!-- Breadcrumbs para SEO -->
    <Breadcrumbs
      className="pl-4 pt-4"
      items={[{ name: "Proyectos", url: "/projects" }]}
    />

    <header class="space-y-6 border mb-20 border-muted p-6 lg:p-8 rounded-5xl">
      <div class="flex flex-col gap-4 pb-4 p-2">
        {
          project.data.logo && (
            <div class="flex h-14 w-fit items-center rounded-2xl border border-muted bg-white px-4 py-2">
              <Image
                src={project.data.logo}
                alt={`Logo de ${project.data.client}`}
                width={180}
                height={56}
                class="max-h-10 w-auto object-contain"
              />
            </div>
          )
        }
        <h1 class="text-4xl md:text-5xl font-bold text-foreground">
          {project.data.title}
        </h1>

        <p class="text-muted-foreground text-pretty max-w-lg">
          {project.data.summary}
        </p>

        {
          project.data.link && (
            <div class="border border-muted p-2 pl-3 w-fit rounded-full">
              <Link href={project.data.link} label="Visitar sitio web" />
            </div>
          )
        }
      </div>
      <div
        class="w-full rounded-4xl object-cover overflow-hidden aspect-video bg-muted"
      >
        <Image
          src={project.data.cover}
          alt={project.data.title}
          width={1200}
          height={600}
          class="project-cover-image object-cover w-full h-full rounded-4xl aspect-video bg-muted"
        />
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        <Highlight label="Cliente" value={project.data.client}>
          <User class="size-5 text-muted-foreground" />
        </Highlight>
        <Highlight
          label={project.data.timelineLabel ? "Estado" : "Timeline"}
          value={timelineText}
        >
          <Timer class="size-5 text-muted-foreground" />
        </Highlight>
      </div>
      <div
        class="mt-4 flex flex-col gap-3 rounded-3xl bg-muted/45 px-4 py-4 sm:flex-row sm:items-center sm:px-5"
      >
        <div
          class="flex shrink-0 items-center gap-2 text-[10px] font-medium uppercase tracking-[0.08em] text-muted-foreground"
        >
          <Layout class="size-4" />
          <span>Servicios</span>
        </div>
        <div class="flex flex-wrap gap-1.5">
          {
            project.data.services_provided?.map((service) => (
              <span class="rounded-full bg-background/80 px-2.5 py-1 text-xs leading-tight text-foreground">
                {service}
              </span>
            ))
          }
        </div>
      </div>
    </header>

    <div
      class="project-content px-2
      prose prose-neutral prose-sm mx-auto w-full max-w-none
      prose-p:max-w-xl prose-p:mx-auto
      prose-ul:max-w-xl prose-ul:mx-auto
      prose-ol:max-w-xl prose-ol:mx-auto
      prose-blockquote:max-w-xl prose-blockquote:mx-auto
      prose-headings:max-w-xl prose-headings:mx-auto
      prose-hr:max-w-xl prose-hr:mx-auto
      prose-table:max-w-xl prose-table:mx-auto
        prose-headings:font-bold prose-headings:text-foreground
        prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-6
        prose-h3:text-2xl prose-h3:mt-8 prose-h3:mb-4
        prose-h4:text-xl prose-h4:mt-6 prose-h4:mb-3
        prose-p:text-muted-foreground
        prose-p:leading-relaxed
        prose-a:text-foreground
        prose-a:underline
        hover:prose-a:no-underline
        prose-strong:text-foreground
        prose-ul:text-muted-foreground
        prose-ol:text-muted-foreground
        prose-li:marker:text-neutral-500
        prose-blockquote:border-l-4
        prose-blockquote:border-neutral-300
        prose-blockquote:italic
        prose-blockquote:text-neutral-600
        prose-code:text-foreground
        prose-pre:bg-foreground"
    >
      <Content />
    </div>
  </article>
  <OtherProjects currentProjectId={project.id} />
</MainLayout>

<script>
  import mediumZoom from "medium-zoom";

  let projectZoom: ReturnType<typeof mediumZoom> | undefined;

  const initProjectMedia = () => {
    const content = document.querySelector<HTMLElement>(".project-content");
    if (!content || content.dataset.mediaReady === "true") return;
    content.dataset.mediaReady = "true";

    projectZoom?.detach();
    const zoomImages = Array.from(
      document.querySelectorAll<HTMLImageElement>(
        ".project-content img, .project-cover-image",
      ),
    );
    projectZoom = mediumZoom(zoomImages, {
      background: "rgba(12,17,11,0.86)",
      margin: 24,
    });

    const imgs = content.querySelectorAll<HTMLImageElement>("img");
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach(({ target, isIntersecting }) => {
          if (isIntersecting) {
            target.classList.add("img-visible");
            io.unobserve(target);
          }
        }),
      { threshold: 0.08, rootMargin: "0px 0px -40px 0px" },
    );
    imgs.forEach((img) => {
      img.setAttribute("data-scroll-reveal", "");
      io.observe(img);
    });
  };

  document.addEventListener("astro:page-load", initProjectMedia);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initProjectMedia, {
      once: true,
    });
  } else {
    initProjectMedia();
  }
</script>
