---
import ProjectCard from "~/components/ui/ProjectCard.astro";
import MainLayout from "~/layouts/MainLayout.astro";
import { getProjects } from "~/shared/lib/collections";

const projects = await getProjects();
const featuredIds = ["cash-movil-canarias", "les-santes", "cyberimpulsa"];
const featuredProjects = featuredIds
  .map((id) => projects.find((project) => project.id === id))
  .filter((project): project is (typeof projects)[number] => Boolean(project));
---

<MainLayout
  title="Proyectos y casos de trabajo | doscientos"
  description="Conoce proyectos reales de producto digital, automatización y sistemas a medida: qué problema había, qué construimos y qué cambió."
>
  <div class="min-h-screen py-16 px-4 sm:py-24 sm:px-6">
    <div class="max-w-7xl mx-auto space-y-12">
      <!-- Header -->
      <header
        class="flex flex-col w-full max-w-2xl items-center justify-center text-center gap-6 mx-auto"
        data-stagger="100"
      >
        <h1
          class="font-semibold text-foreground w-full text-3xl md:text-5xl items-center text-center"
          data-reveal="scale"
          data-speed="normal"
          data-easing="bounce"
        >
          <span>Qué hemos construido </span>
          <span class="text-muted-foreground">con otras empresas.</span>
        </h1>
        <p
          class="text-muted-foreground max-w-md text-pretty"
          data-reveal="bottom"
          data-speed="normal"
          data-easing="soft"
          data-distance="small"
        >
          Si te piden referencias, puedes enviar esta página. Cada caso explica
          el punto de partida, el trabajo realizado y el resultado, con pantallas
          y enlaces cuando podemos enseñarlos.
        </p>
      </header>

      <!-- Stats -->
      <ul
        class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4"
        data-stagger="100"
      >
        <li
          class="p-5 md:p-6 rounded-2xl bg-muted"
          data-reveal="scale"
          data-speed="normal"
          data-easing="bounce"
        >
          <span class="text-3xl md:text-4xl font-bold text-foreground">
            {projects.length + 17}+
          </span>
          <h3 class="text-sm md:text-probase space-x-1 text-muted-foreground">
            Proyectos
          </h3>
        </li>
        <li
          class="p-5 md:p-6 rounded-2xl bg-muted"
          data-reveal="scale"
          data-speed="normal"
          data-easing="bounce"
        >
          <span class="text-3xl md:text-4xl font-bold text-foreground"
            >500+</span
          >
          <h3 class="text-sm md:text-base text-muted-foreground">
            Usuarios activos
          </h3>
        </li>
        <li
          class="p-5 md:p-6 rounded-2xl bg-muted"
          data-reveal="scale"
          data-speed="normal"
          data-easing="bounce"
        >
          <span class="text-3xl md:text-4xl font-bold text-foreground">7+</span>
          <h3 class="text-sm md:text-base text-muted-foreground">
            Años de experiencia
          </h3>
        </li>
        <li
          class="p-5 md:p-6 rounded-2xl bg-muted"
          data-reveal="scale"
          data-speed="normal"
          data-easing="bounce"
        >
          <span class="text-3xl md:text-4xl font-bold text-foreground"
            >99.9%</span
          >
          <h3 class="text-sm md:text-base text-muted-foreground">
            Uptime promedio
          </h3>
        </li>
      </ul>

      <section class="space-y-6" aria-labelledby="featured-projects">
        <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
          <div class="max-w-2xl space-y-2">
            <p class="text-sm font-medium text-muted-foreground">Para empezar</p>
            <h2 id="featured-projects" class="text-3xl md:text-4xl font-bold text-foreground">
              Tres formas de resolver problemas reales.
            </h2>
            <p class="text-muted-foreground max-w-xl">
              Producto digital, operación interna y captación. No hacemos dos proyectos iguales: entendemos el cuello de botella y construimos lo que necesita el equipo.
            </p>
          </div>
          <a href="#todos-los-proyectos" class="text-sm font-semibold underline underline-offset-4 hover:text-primary">
            Ver todos los casos ↓
          </a>
        </div>
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-3" data-stagger="120">
          {featuredProjects.map((project) => (
            <ProjectCard
              id={project.id}
              title={project.data.title}
              client={project.data.client}
              timeline={project.data.timeline}
              timelineUnit={project.data.timelineUnit}
              summary={project.data.summary}
              services_provided={project.data.services_provided}
              color={project.data.color}
              cover={project.data.cover}
            />
          ))}
        </div>
      </section>

      <h2
        id="todos-los-proyectos"
        class="text-3xl md:text-4xl font-bold text-foreground text-center"
        data-reveal="bottom"
        data-speed="normal"
        data-easing="soft"
        data-distance="small"
      >
        Casos de éxito
      </h2>

      <!-- Projects grid -->
      <section
        class="grid grid-cols-1 gap-x-6 gap-y-12 lg:grid-cols-2"
        data-stagger="150"
      >
        {
          projects.map((project) => (
            <article
              class="h-full"
              data-reveal="bottom"
              data-speed="normal"
              data-easing="smooth"
              data-distance="small"
            >
              <ProjectCard
                id={project.id}
                title={project.data.title}
                client={project.data.client}
                timeline={project.data.timeline}
                timelineUnit={project.data.timelineUnit}
                summary={project.data.summary}
                services_provided={project.data.services_provided}
                color={project.data.color}
                cover={project.data.cover}
              />
            </article>
          ))
        }
      </section>
    </div>
  </div>
</MainLayout>
