---
import { Check } from "@lucide/astro";
import ContactForm from "~/components/forms/ContactForm";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import { branding } from "~/config/branding";
import MainLayout from "~/layouts/MainLayout.astro";
import { buildTrackedWhatsappUrl } from "~/shared/lib/attribution";
import { company } from "~/config/company";

const whatsappHref = buildTrackedWhatsappUrl({
  phone: branding.contact.whatsapp.number,
  text: branding.contact.whatsapp.defaultMessage,
  conversionStep: "whatsapp_contact",
  landingRef: "contact",
});
---

<MainLayout
  title="Contacto - Agenda una llamada gratuita | doscientos"
  description="Contacta con doscientos, agencia de software a medida en Premià de Mar. Atendemos empresas del Maresme y Barcelona; reuniones presenciales en nuestra oficina con cita previa."
>
  <section class="px-6 mx-auto pt-20 lg:pt-36 pb-20 w-full">
    <div class="space-y-12 w-full" data-stagger="150">
      <SectionHeader
        title="Empecemos con tu proyecto"
        description="Cuéntanos qué necesitas y te responderemos en menos de 24 horas. Sin compromiso."
        align="center"
      />

      <ul
        class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-muted-foreground"
        aria-label="Lo que puedes esperar"
        data-reveal="bottom"
      >
        {
          [
            "Respuesta en menos de 24h",
            "Llamada de 15 min sin compromiso",
            "Diagnóstico inicial gratuito",
          ].map((item) => (
            <li class="flex items-center gap-2">
              <Check class="size-4 text-primary" aria-hidden="true" />
              {item}
            </li>
          ))
        }
      </ul>

      <div class="flex flex-col gap-8 items-center">
        <article
          class="bg-muted/30 w-full rounded-3xl px-4 py-6 md:px-6 md:py-8 max-w-2xl mx-auto"
        >
          <ContactForm client:load />
        </article>

        <p class="text-muted-foreground text-sm" data-reveal="bottom">
          ¿Prefieres algo más directo?{" "}
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary font-bold hover:underline"
          >
            Chat por WhatsApp
          </a>
        </p>
        <address class="not-italic text-center text-sm text-muted-foreground" data-reveal="bottom">
          <strong class="text-foreground">Oficina en Premià de Mar</strong><br />
          {company.officeAddress.streetAddress}, {company.officeAddress.postalCode} {company.officeAddress.addressLocality}, {company.officeAddress.addressRegion}<br />
          Reuniones presenciales con cita previa · atendemos proyectos del Maresme y Barcelona.
          <br />
          <a
            href="https://www.google.com/maps/search/?api=1&query=Carrer+Joan+XXIII%2C+8%2C+08330+Premi%C3%A0+de+Mar%2C+Barcelona"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-2 inline-block min-h-11 py-3 font-bold text-primary hover:underline"
          >
            Cómo llegar a la oficina
          </a>
        </address>
        <p class="text-muted-foreground text-sm" data-reveal="bottom">
          ¿Prefieres empezar con una orientación rápida?{" "}
          <a
            href="/diagnostico?ref=contact-alternative"
            class="text-primary font-bold hover:underline"
          >
            Pide un diagnóstico gratis
          </a>
          {" "}y aproximamos qué proceso merece la pena mejorar primero.
        </p>
      </div>
    </div>
  </section>
</MainLayout>
