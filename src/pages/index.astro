---
import MainLayout from "~/layouts/MainLayout.astro";

import Authority from "~/components/sections/Authority.astro";
import CaseStudies from "~/components/sections/CaseStudies.astro";
import ClientsCarousel from "~/components/sections/ClientsCarousel.astro";
import Comparison from "~/components/sections/Comparison.astro";
import FAQ from "~/components/sections/FAQ.astro";
import ForWho from "~/components/sections/ForWho.astro";
import Hero from "~/components/sections/Hero.astro";
import Hype from "~/components/sections/Hype.astro";
import Impact from "~/components/sections/Impact.astro";
import LocalPartner from "~/components/sections/LocalPartner.astro";
import Method from "~/components/sections/Method.astro";
import OpenSource from "~/components/sections/OpenSource.astro";
import PostLaunch from "~/components/sections/PostLaunch.astro";
import Services from "~/components/sections/Services.astro";
import Testimonials from "~/components/sections/Testimonials.astro";
import ProjectsBadge from "~/components/ui/ProjectsBadge.astro";

const title = "Software a medida y automatización para pymes | doscientos";
const description =
  "Creamos software a medida, CRM, ERP y automatizaciones para pymes de Barcelona y el Maresme. Base en Premià de Mar, precio cerrado y entrega en 6 semanas.";
---

<MainLayout title={title} description={description}>
  <div class="home-top-surface">
    <!-- Block-level wrapper so ScrollTrigger's pin-spacer lives in normal flow.
         Pinning a direct flex child of <main> collapses pin-spacing to 0. -->
    <div class="block">
      <Hero />
    </div>
    <ProjectsBadge />
    <div class="relative z-20 w-full">
      <ClientsCarousel />
    </div>
  </div>
  <Impact />
  <Services />
  <CaseStudies />
  <ForWho />
  <Method />
  <OpenSource />
  <PostLaunch />
  <Testimonials />
  <Authority />
  <Comparison />
  <FAQ />
  <LocalPartner />
  <Hype />
</MainLayout>

<style>
  .home-top-surface {
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--foreground) 6%, var(--background)) 0%,
      color-mix(in srgb, var(--foreground) 5%, var(--background)) 48%,
      var(--background) 100%
    );
  }
</style>
