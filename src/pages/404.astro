---
import { ArrowRight, ArrowUpRight, BookOpen, FolderOpen } from "@lucide/astro";
import MainLayout from "~/layouts/MainLayout.astro";

const destinations = [
  {
    label: "Proyectos",
    description: "Descubre lo que hemos construido.",
    href: "/projects",
    icon: FolderOpen,
  },
  {
    label: "Recursos",
    description: "Ideas para hacer avanzar tu negocio.",
    href: "/recursos",
    icon: BookOpen,
  },
];
---

<MainLayout
  title="404 - Página no encontrada"
  description="La página que buscas no existe o ha sido movida."
  robots="noindex, nofollow"
  showFooterCta={false}
>
  <section class="mx-auto w-full max-w-7xl px-4 pt-28 sm:px-6 sm:pt-32">
    <div class="overflow-hidden rounded-[2rem] bg-primary text-white sm:rounded-[2.5rem]">
      <div class="grid items-center gap-10 px-6 py-10 sm:px-10 sm:py-14 lg:grid-cols-2 lg:gap-12 lg:px-16 lg:py-16">
        <div class="max-w-xl">
          <h1 class="text-balance text-4xl font-semibold leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl">
            Esta página se ha perdido.
          </h1>
          <p class="mt-6 max-w-md text-pretty text-base leading-relaxed text-white/80 sm:text-lg">
            No encontramos lo que buscas. Puede que la página haya cambiado de dirección o ya no exista.
          </p>
          <p class="mt-3 text-sm text-white/70">Error 404</p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a
              href="/"
              class="inline-flex min-h-12 items-center justify-center gap-3 rounded-full bg-[var(--brand-lime)] px-6 py-3 font-semibold text-primary transition-colors hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
            >
              Volver al inicio
              <ArrowRight class="size-4" aria-hidden="true" />
            </a>
            <a
              href="/contact"
              class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full border border-white/40 px-6 py-3 font-medium text-white transition-colors hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
            >
              Hablar con nosotros
            </a>
          </div>
        </div>

        <div class="error-art relative flex min-h-64 items-center justify-center overflow-hidden rounded-3xl border border-white/15 bg-white/[0.05] sm:min-h-80 lg:min-h-96" aria-hidden="true">
          <div class="absolute size-48 rounded-full border border-dashed border-white/25 sm:size-64"></div>
          <div class="absolute size-36 rounded-full border border-white/10 sm:size-48"></div>
          <span class="relative select-none text-[clamp(7rem,20vw,13rem)] font-bold leading-none tracking-[-0.08em] text-[var(--brand-lime)]">404</span>
          <span class="absolute left-[18%] top-[24%] size-3 rounded-full bg-[var(--brand-lime)]"></span>
          <span class="absolute bottom-[23%] right-[18%] size-4 rounded-full border-4 border-[var(--brand-lime)]"></span>
        </div>
      </div>
    </div>

    <div class="mt-10 sm:mt-12">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">Por aquí sí puedes seguir</h2>
        <p class="text-sm text-muted-foreground">Un par de buenos lugares para empezar.</p>
      </div>
      <nav aria-label="Páginas recomendadas" class="mt-5 grid gap-3 sm:grid-cols-2">
        {
          destinations.map(({ label, description, href, icon: Icon }) => (
            <a
              href={href}
              class="group flex min-h-24 items-center gap-4 rounded-2xl border border-foreground/10 bg-white p-5 transition-colors hover:border-primary/30 hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
            >
              <span class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-accent text-primary">
                <Icon class="size-5" aria-hidden="true" />
              </span>
              <span class="min-w-0 flex-1">
                <span class="block font-semibold">{label}</span>
                <span class="mt-1 block text-sm text-muted-foreground">{description}</span>
              </span>
              <ArrowUpRight class="size-5 shrink-0 text-primary" aria-hidden="true" />
            </a>
          ))
        }
      </nav>
    </div>
  </section>
</MainLayout>

<style>
  .error-art {
    background-image: radial-gradient(circle, rgb(255 255 255 / 0.12) 1px, transparent 1px);
    background-size: 22px 22px;
  }
</style>
