---
/**
 * ConsentScript — debe ir PRIMERO en <head>, antes de cualquier tracker.
 *
 * Implementa Google Consent Mode v2 (gtag.js):
 *  1. Inicializa window.dataLayer y window.gtag.
 *  2. Llama consent 'default' con todo denied para todos los visitantes.
 *  3. Solo acepta preferencias válidas durante seis meses; después vuelve a
 *     pedir una elección y elimina identificadores anteriores.
 *  4. Expone window.__DOS_CONSENT para el resto de componentes.
 */
---

<script is:inline>
  (function () {
    // ── 1. dataLayer + gtag (deben existir antes del consent 'default') ──
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () {
      dataLayer.push(arguments);
    };

    // Elección conservadora: no cargar ni almacenar analítica/publicidad sin
    // una elección afirmativa, independientemente de la ubicación detectada.
    gtag("consent", "default", {
      ad_storage: "denied",
      ad_user_data: "denied",
      ad_personalization: "denied",
      analytics_storage: "denied",
      functionality_storage: "granted",
      security_storage: "granted",
      wait_for_update: 500,
    });

    // Mantener los IDs de clic fuera de las URLs públicas. No hay medición
    // entre dominios en la landing, así que no activamos URL passthrough (_gl).
    gtag("set", "ads_data_redaction", true);

    // ── 3. Leer preferencias vigentes (máximo seis meses) ──
    try {
      var stored = localStorage.getItem("doscientos-consent");
      var parsed = stored ? JSON.parse(stored) : null;
      var savedAt = parsed ? Date.parse(parsed.date) : NaN;
      var valid =
        parsed &&
        typeof parsed.analytics === "boolean" &&
        typeof parsed.marketing === "boolean" &&
        Number.isFinite(savedAt) &&
        Date.now() >= savedAt &&
        Date.now() - savedAt < 180 * 24 * 60 * 60 * 1000;
      window.__DOS_CONSENT = valid ? parsed : null;
      if (stored && !valid) localStorage.removeItem("doscientos-consent");
      if (!valid) {
        localStorage.removeItem("doscientos:first-touch");
        localStorage.removeItem("doscientos:visitor-id");
        sessionStorage.removeItem("doscientos:event-id");
      }
    } catch (_) {
      window.__DOS_CONSENT = null;
    }

    // ── 4. Si ya hay consent guardado, actualizar estado antes de que GA4 cargue ──
    if (window.__DOS_CONSENT) {
      var c = window.__DOS_CONSENT;
      gtag("consent", "update", {
        analytics_storage: c.analytics ? "granted" : "denied",
        ad_storage: c.marketing ? "granted" : "denied",
        ad_user_data: c.marketing ? "granted" : "denied",
        ad_personalization: c.marketing ? "granted" : "denied",
      });
    }
  })();
</script>
