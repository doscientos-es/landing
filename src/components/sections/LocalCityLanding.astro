---
import Breadcrumbs from "~/components/seo/Breadcrumbs.astro";
import Button from "~/components/ui/Button.astro";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import MainLayout from "~/layouts/MainLayout.astro";
import { getProjects } from "~/shared/lib/collections";

interface Props { city: string; slug: string; nearby: string; intro: string; question: string; }
const { city, slug, nearby, intro, question } = Astro.props;
const projects = await getProjects(3);
---
<MainLayout title={`Agencia de desarrollo web en ${city} | doscientos`} description={`Agencia web y software a medida en ${city}. Desarrollamos webs, MVPs, CRMs y automatizaciones para empresas de ${city} y el Maresme.`} service={{ name: `Desarrollo web y software a medida en ${city}`, description: intro, serviceType: "Software Development" }} type="website">
  <section class="px-6 max-w-7xl mx-auto pt-32 space-y-16">
    <Breadcrumbs items={[{ name: city, url: `/${slug}` }]} />
    <header class="max-w-3xl mx-auto text-center space-y-8">
      <h1 class="text-4xl md:text-6xl font-bold text-foreground">Agencia de desarrollo web en {city}<span class="block text-primary mt-2">Software que entiende tu negocio.</span></h1>
      <p class="text-xl text-muted-foreground max-w-2xl mx-auto">{intro} Trabajamos desde Premià de Mar y nos reunimos contigo en {city}, {nearby} y el resto del Maresme.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center"><a href="/contact"><Button size="lg" withArrow>Hablar de tu proyecto</Button></a><a href="/projects"><Button size="lg">Ver proyectos</Button></a></div>
    </header>
    <section class="grid md:grid-cols-3 gap-6">
      {[
        ["Webs profesionales", "Una presencia digital clara, rápida y preparada para convertir."],
        ["Software a medida", "CRMs, ERPs y portales que encajan con cómo trabaja tu equipo."],
        ["Automatización", "Menos tareas manuales y más tiempo para el trabajo que importa."],
      ].map(([title, description]) => <div class="p-8 rounded-2xl bg-accent space-y-4"><h2 class="text-xl font-semibold text-foreground">{title}</h2><p class="text-muted-foreground">{description}</p></div>)}
    </section>
    <section class="space-y-10"><SectionHeader title={`Proyectos con impacto local`} subtitle={`desde ${city}`} description="Diseñamos productos digitales para empresas y organizaciones que necesitan avanzar." align="center" /><div class="grid md:grid-cols-3 gap-6">{projects.map((project) => <a href={`/projects/${project.id}`} class="group p-6 rounded-2xl bg-accent"><h3 class="text-xl font-semibold group-hover:text-primary">{project.data.title}</h3><p class="text-muted-foreground mt-2">{project.data.summary}</p></a>)}</div></section>
    <section class="max-w-3xl mx-auto space-y-6"><SectionHeader title="Preguntas frecuentes" subtitle={`${city} y el Maresme`} align="center" /><div class="p-6 rounded-2xl bg-accent"><h2 class="font-semibold text-lg">{question}</h2><p class="text-muted-foreground mt-2">Sí. Estamos en Premià de Mar y podemos reunirnos presencialmente en {city} y alrededores. También trabajamos en remoto con empresas de toda España. Primero entendemos el proceso, después proponemos la solución con alcance y precio claros.</p></div></section>
    <section class="bg-primary text-background rounded-3xl p-12 text-center space-y-6"><h2 class="text-3xl md:text-4xl font-bold">¿Tienes un proyecto en {city}?</h2><p class="text-xl opacity-90 max-w-2xl mx-auto">Cuéntanos qué quieres mejorar y te diremos qué camino tiene sentido.</p><a href="/contact"><Button size="lg" withArrow class="bg-background text-primary hover:bg-background/90">Agendar reunión</Button></a></section>
  </section>
</MainLayout>
