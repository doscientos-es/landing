---
import { getProjects } from "~/shared/lib/collections";
import ClientLogo from "../ui/clients/ClientLogo.astro";

const projectsWithLogo = (await getProjects()).filter(
  (project) => project.data.logo,
);
const featuredProjects = projectsWithLogo.slice(0, 8);
const DEFAULT_LOGO_SIZE = { width: 90, height: 30 };
const LOGO_SIZES: Record<string, typeof DEFAULT_LOGO_SIZE> = {
  arenas: { width: 88, height: 32 },
  "cash-movil-canarias": { width: 76, height: 38 },
  cyberimpulsa: { width: 112, height: 30 },
  flatmatch: { width: 76, height: 36 },
  ifco: { width: 96, height: 30 },
  "les-santes": { width: 90, height: 34 },
  optinergia: { width: 80, height: 36 },
  palumba: { width: 42, height: 42 },
  salvadis: { width: 104, height: 34 },
};
---

<section class="clients-section w-full">
  <div class="max-w-5xl mx-auto px-6 py-8 md:py-10">
    <p
      class="text-center text-xs font-bold text-foreground mb-5"
      data-reveal="top"
      data-speed="fast"
      data-easing="smooth"
      data-distance="small"
    >
      Empresas que confían en nosotros
    </p>

    <ul
      class="mx-auto flex max-w-[32rem] flex-wrap items-center justify-center gap-[0.9rem] [&_.client-logo-wrapper]:opacity-60 max-[639px]:gap-x-[0.55rem] max-[639px]:gap-y-[0.8rem]"
      aria-label="Clientes de doscientos"
      data-reveal="scale"
      data-speed="normal"
      data-easing="smooth"
    >
      {
        featuredProjects.map((project) => {
          const size = LOGO_SIZES[project.id] ?? DEFAULT_LOGO_SIZE;

          return (
            <li class="flex items-center justify-center">
              <ClientLogo
                logo={project.data.logo!}
                alt={`Logo de ${project.data.client}`}
                height={size.height}
                width={size.width}
              />
            </li>
          );
        })
      }
      <li
        class="inline-flex min-h-8 items-center justify-center whitespace-nowrap rounded-full bg-background px-[0.7rem] py-[0.4rem] text-[0.72rem] font-[750] text-foreground shadow-[0_4px_12px_color-mix(in_srgb,var(--foreground)_8%,transparent)]"
        aria-label="Más de 20 proyectos entregados"
      >
        20+ más
      </li>
    </ul>
  </div>
</section>
