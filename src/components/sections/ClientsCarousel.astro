---
import { getProjects } from "~/shared/lib/collections";
import ClientLogo from "../ui/clients/ClientLogo.astro";

const projectsWithLogo = (await getProjects()).filter(
  (project) => project.data.logo,
);
const featuredIds = [
  "gruas-del-valles",
  "kache-envios",
  "palumba",
  "salvadis",
  "ifco",
  "les-santes",
  "cyberimpulsa",
  "cash-movil-canarias",
];
const featuredProjects = featuredIds
  .map((id) => projectsWithLogo.find((project) => project.id === id))
  .filter((project): project is (typeof projectsWithLogo)[number] => Boolean(project));
const LOGO_FRAME = { width: 96, height: 34 };
---

<section class="clients-section w-full">
  <div class="max-w-5xl mx-auto px-6 py-8 md:py-10">
    <p
      class="text-center text-xs font-bold text-foreground mb-5"
      data-reveal="top"
      data-speed="fast"
      data-easing="smooth"
      data-distance="small"
    >
      Una selección de proyectos reales
    </p>

    <ul
      class="mx-auto flex max-w-[32rem] flex-wrap items-center justify-center gap-[0.9rem] [&_.client-logo-wrapper]:opacity-60 max-[639px]:gap-x-[0.55rem] max-[639px]:gap-y-[0.8rem]"
      aria-label="Clientes de doscientos"
      data-reveal="scale"
      data-speed="normal"
      data-easing="smooth"
    >
      {
        featuredProjects.map((project) => {
          return (
            <li class="flex items-center justify-center">
              <ClientLogo
                logo={project.data.logo!}
                alt={`Logo de ${project.data.client}`}
                height={LOGO_FRAME.height}
                width={LOGO_FRAME.width}
                class={project.id}
              />
            </li>
          );
        })
      }
      <li
        class="inline-flex items-center justify-center whitespace-nowrap px-[0.2rem] py-[0.35rem] text-[0.68rem] font-semibold text-muted-foreground"
        aria-label="Más de 20 proyectos entregados"
      >
        +20 proyectos
      </li>
    </ul>
  </div>
</section>
