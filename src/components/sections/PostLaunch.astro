---
import { Check, Rocket, ShieldCheck } from "@lucide/astro";
import LifeBuoy from "@lucide/astro/icons/life-buoy";
import SectionHeader from "~/components/ui/SectionHeader.astro";

const stages = [
  {
    icon: Rocket,
    title: "Lanzamiento acompañado",
    text: "Publicamos el producto, configuramos la analítica y la monitorización, y te entregamos el código y la documentación.",
  },
  {
    icon: ShieldCheck,
    title: "30 días incluidos",
    text: "Corregimos errores del alcance acordado y respondemos a las dudas del equipo durante el primer mes de producción.",
  },
  {
    icon: LifeBuoy,
    title: "Mantenimiento y evolución",
    text: "Si quieres seguir contando con nosotros, siempre ofrecemos planes de mantenimiento para cuidar el software y atender incidencias, además de trabajo de evolución con alcance acordado. También puedes continuar con tu propio equipo.",
  },
];
---

<section class="landing-section bg-accent/5" id="post-lanzamiento">
  <SectionHeader
    title="Seguimos a tu lado después del lanzamiento"
    description="Entregamos el código y la documentación para que tengas el control. Y si quieres que sigamos cuidando el software, siempre ofrecemos planes de mantenimiento."
    align="center"
  />

  <div class="grid gap-4 md:grid-cols-3 max-w-6xl mx-auto w-full">
    {
      stages.map(({ icon: Icon, title, text }, index) => (
        <article
          class="rounded-2xl border border-muted bg-background p-6 md:p-8"
          data-reveal="bottom"
          data-delay={index * 100}
        >
          <div class="flex size-11 items-center justify-center rounded-xl bg-primary/10 text-primary">
            <Icon class="size-5" aria-hidden="true" />
          </div>
          <h3 class="mt-6 text-xl font-semibold text-foreground text-balance">
            {title}
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            {text}
          </p>
        </article>
      ))
    }
  </div>

  <div
    class="mx-auto mt-8 flex max-w-6xl flex-wrap justify-center gap-x-8 gap-y-3 text-sm text-muted-foreground"
  >
    <span class="inline-flex items-center gap-2"
      ><Check class="size-4 text-green-600" /> Código y repositorio tuyos</span
    >
    <span class="inline-flex items-center gap-2"
      ><Check class="size-4 text-green-600" /> Sin lock-in</span
    >
    <span class="inline-flex items-center gap-2"
      ><Check class="size-4 text-green-600" /> Soporte con alcance claro</span
    >
  </div>
</section>
