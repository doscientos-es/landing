---
import { Check } from "@lucide/astro";
import SectionHeader from "../ui/SectionHeader.astro";

const rows = [
  { label: "Alcance", value: "Lo definimos antes de empezar" },
  { label: "Presupuesto", value: "Precio acordado para ese alcance" },
  { label: "Seguimiento", value: "Demos semanales durante el desarrollo" },
  { label: "Propiedad", value: "El código y los repositorios son tuyos" },
  { label: "Después del lanzamiento", value: "30 días de soporte incluidos y planes de mantenimiento disponibles" },
];
---

<section id="como-trabajamos" class="landing-section">
  <SectionHeader
    title="Claridad en cada etapa"
    subtitle="Así trabajamos"
    description="Antes de empezar, dejamos claros el alcance, el presupuesto y cómo revisaremos el avance."
    align="center"
  />

  <div
    role="table"
    aria-label="Qué puedes esperar al trabajar con doscientos"
    class="rounded-2xl overflow-hidden border border-muted"
    data-reveal="bottom"
    data-speed="normal"
    data-easing="soft"
  >
    <div role="rowgroup">
      {rows.map((row, i) => (
        <div
          role="row"
          class={`grid grid-cols-[minmax(8rem,0.7fr)_1.3fr] border-t border-muted first:border-t-0 ${i % 2 === 0 ? "bg-background" : "bg-accent/40"}`}
        >
          <div role="rowheader" class="p-4 text-sm font-medium text-muted-foreground">
            {row.label}
          </div>
          <div role="cell" class="p-4 text-sm font-semibold text-primary border-l border-muted flex items-center gap-2">
            <Check aria-hidden="true" class="size-4 text-green-500 shrink-0" />
            {row.value}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
