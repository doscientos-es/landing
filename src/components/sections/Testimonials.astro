---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { Check, Star } from "@lucide/astro";
import SectionHeader from "../ui/SectionHeader.astro";

import carlosImg from "~/assets/media/testimonials/carlos-ruiz.webp";
import michaelImg from "~/assets/media/testimonials/michael-schmidt.webp";
import sofiaImg from "~/assets/media/testimonials/sofia-martinez.webp";
import cyberimpulsaLogo from "~/assets/media/projects/cyberimpulsa/logo.svg";
import salvadisLogo from "~/assets/media/projects/salvadis/logo.webp";

type Testimonial = {
  quote: string;
  author: string;
  role: string;
  company?: string;
  project: string;
  rating?: number;
  metrics: string;
  highlight: string;
  image?: ImageMetadata;
  imageIsLogo?: boolean;
};

const testimonials: Testimonial[] = [
  {
    quote:
      "Muy buena experiencia con Doscientos. Profesionalidad, cercanía y muy buena atención desde el primer momento. Nos ayudaron con la puesta en marcha de la web y con diferentes cuestiones técnicas, siempre de forma rápida y profesional. Muy satisfechos con el trato y el servicio. Totalmente recomendable.",
    author: "Salvadis",
    role: "Reseña de Google",
    project: "Web corporativa y soporte técnico",
    rating: 5,
    metrics: "Puesta en marcha web · Soporte técnico",
    highlight: "Atención rápida y profesional",
    image: salvadisLogo,
    imageIsLogo: true,
  },
  {
    quote:
      "Trabajar con Doscientos ha sido una muy buena decisión. Necesitábamos una página web que transmitiera profesionalidad nada más entrar y eso mismo es lo que han conseguido. Una empresa seria y muy buenos profesionales, gracias!",
    author: "Cyberimpulsa",
    role: "Reseña de Google",
    project: "Landing web",
    rating: 5,
    metrics: "Página web · Imagen profesional",
    highlight: "Una web que transmite profesionalidad",
    image: cyberimpulsaLogo,
    imageIsLogo: true,
  },
  {
    quote:
      "Ràpids, clars i molt professionals. M'han ajudat a prioritzar bé i a no complicar el projecte innecessàriament. Han fet el disseny, m'han acompanyat en el proces i el producte m'ha encantat!",
    author: "Natura Studio",
    role: "Ressenya de Google",
    project: "Disseny web",
    metrics: "Disseny · Priorització · Acompanyament",
    highlight: "Un procés clar i sense complicacions",
  },
];
---

<section class="landing-section bg-accent/5">
  <SectionHeader
    title="Lo que dicen nuestros clientes"
    description="Testimonios y métricas de proyectos que podemos documentar"
    align="center"
  />

  <div
    class="grid md:grid-cols-2 xl:grid-cols-3 gap-4 max-w-6xl mx-auto w-full"
    data-stagger="100"
  >
    {
      testimonials.map((testimonial, i) => {
        const isFeatured = i === 1;
        return (
          <div
            class={`testimonial-card rounded-2xl p-8 flex flex-col gap-4 ${
              isFeatured
                ? "bg-foreground text-background shadow-xl md:-translate-y-4 md:scale-[1.02] z-10"
                : "bg-background border border-muted shadow-pastel"
            }`}
            data-reveal="bottom"
            data-speed="normal"
            data-easing="soft"
          >
            {/* Rating */}
            {testimonial.rating && (
              <div class="flex gap-0" aria-hidden="true">
                {Array.from({ length: testimonial.rating }).map(() => (
                  <Star
                    class="size-5 text-yellow-400"
                    fill="currentColor"
                    stroke="currentColor"
                    aria-hidden="true"
                  />
                ))}
              </div>
            )}

            {/* Highlight badge */}
            <div
              class={`inline-flex items-center gap-2 px-3 py-1 rounded-md w-fit text-xs font-semibold ${
                isFeatured
                  ? "bg-background/15 text-background"
                  : "bg-primary/10 text-primary"
              }`}
            >
              <Check class="size-3" />
              {testimonial.highlight}
            </div>

            {/* Quote */}
            <blockquote
              class={`leading-relaxed flex-1 ${isFeatured ? "text-background/90" : "text-foreground"}`}
            >
              "{testimonial.quote}"
            </blockquote>

            {/* Metrics */}
            <div
              class={`px-4 py-3 rounded-lg border mb-3 ${
                isFeatured
                  ? "border-background/20 bg-background/10"
                  : "border-muted"
              }`}
            >
              <p
                class={`text-sm font-semibold ${isFeatured ? "text-background/70" : "text-muted-foreground"}`}
              >
                {testimonial.metrics}
              </p>
            </div>

            {/* Author */}
            <div
              class={`flex items-start gap-3 pt-2 border-t ${isFeatured ? "border-background/20" : "border-muted"}`}
            >
              {testimonial.image ? (
                <Image
                  src={testimonial.image}
                  alt={testimonial.author}
                  width={40}
                  height={40}
                  class={`size-10 rounded-full mt-2 shrink-0 ${testimonial.imageIsLogo ? "object-contain bg-white p-1" : "object-cover object-top"}`}
                />
              ) : (
                <div
                  aria-hidden="true"
                  class="size-10 rounded-full mt-2 shrink-0 flex items-center justify-center bg-primary/10 text-primary font-semibold"
                >
                  {testimonial.author.slice(0, 1)}
                </div>
              )}
              <div class="mt-2">
                <p
                  class={`font-semibold ${isFeatured ? "text-background" : "text-foreground"}`}
                >
                  {testimonial.author}
                </p>
                <p
                  class={`text-xs ${isFeatured ? "text-background/60" : "text-muted-foreground"}`}
                >
                  {testimonial.role}
                  {testimonial.company ? `, ${testimonial.company}` : ""}
                </p>
                <p
                  class={`text-xs mt-1 ${isFeatured ? "text-background/60" : "text-muted-foreground"}`}
                >
                  Proyecto: {testimonial.project}
                </p>
              </div>
            </div>
          </div>
        );
      })
    }
  </div>

  {/* Trust indicators */}
  <div
    class="flex flex-wrap justify-center items-center gap-8 text-sm text-muted-foreground"
    data-reveal="bottom"
    data-speed="normal"
    data-easing="soft"
  >
    <div class="flex items-center gap-2">
      <Check class="size-5 text-green-500" />
      <span>Casos con métricas operativas</span>
    </div>
    <div class="flex items-center gap-2">
      <Check class="size-5 text-green-500" />

      <span>Demos y alcance definidos por escrito</span>
    </div>
    <div class="flex items-center gap-2">
      <Check class="size-5 text-green-500" />

      <span>Soporte post-lanzamiento incluido</span>
    </div>
  </div>
</section>
