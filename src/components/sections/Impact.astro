---
import { getProjects } from "~/shared/lib/collections";

const projects = await getProjects();
const projectById = new Map(projects.map((project) => [project.id, project]));

const highlights = [
  {
    id: "flatmatch",
    result: "500+",
    resultLabel: "usuarios orgánicos en 3 meses",
    title: "Una experiencia que hizo crecer el producto",
    description:
      "Diseñamos y desarrollamos una plataforma de alojamiento temporal que convirtió encontrar piso en una experiencia mucho más sencilla.",
  },
  {
    id: "bitacora",
    result: "-90%",
    resultLabel: "de tiempo en procesos manuales",
    title: "De tres horas de trabajo a quince minutos",
    description:
      "Conectamos facturación, generación de documentos y contabilidad dentro de un ERP de logística y aduanas.",
  },
  {
    id: "ifco",
    result: "0 min",
    resultLabel: "de interrupción durante la migración",
    title: "Modernización sin parar la operación",
    description:
      "Migramos más de un millón de registros y mantuvimos el negocio activo durante todo el proceso.",
  },
];
---

<section
  class="w-full px-6 py-12 max-[640px]:px-4 max-[640px]:py-8"
  aria-labelledby="impact-title"
>
  <div class="mx-auto w-full max-w-[75rem]">
    <header
      class="mb-14 grid items-end gap-6 min-[901px]:grid-cols-[minmax(0,1.15fr)_minmax(18rem,0.85fr)] min-[901px]:gap-16 max-[640px]:mb-8"
    >
      <div>
        <h2
          id="impact-title"
          class="m-0 max-w-3xl text-[clamp(2.25rem,4.25vw,4.25rem)] font-extrabold leading-[0.98] tracking-[-0.07em] text-foreground text-balance max-[640px]:text-[clamp(2.5rem,12vw,4rem)]"
        >
          Trabajo que ya está cambiando negocios
        </h2>
      </div>
      <div class="max-w-[22rem] pb-[0.2rem] max-[900px]:max-w-[30rem]">
        <p class="m-0 mb-5 text-[0.95rem] leading-[1.55] text-muted-foreground">
          Sistemas, productos y automatizaciones que están en producción y
          resuelven problemas reales todos los días.
        </p>
        <a
          href="/projects"
          class="group text-[0.82rem] font-extrabold text-primary underline decoration-[color-mix(in_srgb,var(--brand-lime)_85%,var(--primary))] underline-offset-[0.3rem]"
          >Ver todos los proyectos <span
            class="inline-block transition-transform duration-200 group-hover:translate-x-[0.15rem] group-hover:-translate-y-[0.15rem]"
            aria-hidden="true">↗</span
          ></a
        >
      </div>
    </header>

    <div class="impact-grid grid grid-cols-3 gap-8 max-[900px]:grid-cols-1">
      {
        highlights.map((item) => {
          const project = projectById.get(item.id);
          if (!project) return null;

          return (
            <a
              href={`/projects/${project.id}`}
              class="group flex min-h-[21rem] flex-col items-start gap-4 border-t border-t-[color-mix(in_srgb,var(--foreground)_18%,transparent)] pt-5 max-[900px]:min-h-0 max-[900px]:pb-10"
            >
              <div class="text-[0.68rem] font-extrabold text-primary">
                {project.data.client}
              </div>
              <h3 class="m-0 text-[clamp(1.35rem,2.2vw,2rem)] font-[750] leading-none tracking-[-0.045em] text-foreground text-balance transition-colors duration-200 group-hover:text-primary">
                {item.title}
              </h3>
              <p class="m-0 text-[0.84rem] leading-[1.5] text-muted-foreground">
                {item.description}
              </p>
              <div class="mt-auto flex flex-col gap-[0.35rem]">
                <strong class="text-[clamp(2rem,3vw,2.75rem)] font-extrabold leading-[0.9] tracking-[-0.06em] text-primary">
                  {item.result}
                </strong>
                <span class="max-w-44 text-[0.72rem] leading-[1.35] text-muted-foreground">
                  {item.resultLabel}
                </span>
              </div>
              <span class="text-[0.82rem] font-extrabold text-primary underline decoration-[color-mix(in_srgb,var(--brand-lime)_85%,var(--primary))] underline-offset-[0.3rem]">
                Ver caso{" "}
                <span
                  class="inline-block transition-transform duration-200 group-hover:translate-x-[0.15rem] group-hover:-translate-y-[0.15rem]"
                  aria-hidden="true"
                >
                  ↗
                </span>
              </span>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
