---
import { Icon } from "astro-icon/components";
import { branding } from "~/config/branding";

const sources = [
  {
    label: "Google Drive",
    icon: "simple-icons:googledrive",
    accent: "#4285f4",
  },
  { label: "Gmail", icon: "simple-icons:gmail", accent: "#ea4335" },
  { label: "Notion", icon: "simple-icons:notion", accent: "#171717" },
];

const destinations = [
  {
    label: "WhatsApp Business",
    icon: "simple-icons:whatsapp",
    accent: "#25d366",
  },
  {
    label: "Google Calendar",
    icon: "simple-icons:googlecalendar",
    accent: "#4285f4",
  },
  { label: "Slack", icon: "simple-icons:slack", accent: "#611f69" },
];
---

<section
  class="w-full px-6 py-20 max-[640px]:px-4 max-[640px]:py-14"
  aria-labelledby="integrations-title"
>
  <div class="mx-auto w-full max-w-6xl">
    <header class="mx-auto mb-12 max-w-[42rem] text-center" data-stagger="80">
      <h2
        id="integrations-title"
        class="m-0 text-[clamp(2.25rem,4.3vw,4.25rem)] font-extrabold leading-[0.98] tracking-[-0.07em] text-foreground text-balance"
        data-reveal="scale"
        data-easing="smooth"
      >
        Tus herramientas, conectadas.
      </h2>
      <p
        class="mx-auto mt-5 max-w-[34rem] text-base leading-[1.55] text-muted-foreground text-pretty"
        data-reveal="bottom"
        data-easing="soft"
        data-distance="small"
      >
        Conectamos Drive, correo, WhatsApp y las herramientas que ya usas para
        que la información fluya sin trabajo manual.
      </p>
    </header>

    <div
      class="integration-map"
      role="img"
      aria-label="Doscientos conecta Google Drive, Gmail y Notion con WhatsApp Business, Google Calendar y Slack"
      data-reveal="bottom"
      data-speed="normal"
      data-easing="smooth"
    >
      <svg
        class="integration-map__lines"
        viewBox="0 0 720 310"
        fill="none"
        aria-hidden="true"
      >
        <defs>
          <linearGradient
            id="integration-line-gradient"
            x1="0"
            y1="0"
            x2="1"
            y2="0"
          >
            <stop offset="0" stop-color="currentColor" stop-opacity="0.22"
            ></stop>
            <stop offset="0.5" stop-color="currentColor" stop-opacity="0.72"
            ></stop>
            <stop offset="1" stop-color="currentColor" stop-opacity="0.22"
            ></stop>
          </linearGradient>
        </defs>
        <path d="M138 54H224L310 155H360"></path>
        <path d="M138 155H360"></path>
        <path d="M138 256H224L310 155H360"></path>
        <path d="M360 155H410L496 54H582"></path>
        <path d="M360 155H582"></path>
        <path d="M360 155H410L496 256H582"></path>
      </svg>

      <ul class="integration-tools integration-tools--sources">
        {
          sources.map((tool, index) => (
            <li
              class="integration-tool"
              style={`--tool-delay: ${index * 90}ms; --tool-accent: ${tool.accent}`}
            >
              <span class="integration-tool__icon-wrap">
                <Icon
                  name={tool.icon}
                  class="integration-tool__icon"
                  aria-hidden="true"
                />
              </span>
              <span>{tool.label}</span>
            </li>
          ))
        }
      </ul>

      <div class="integration-center">
        <span class="integration-center__status"><i></i> Conectado</span>
        <img src={branding.assets.isotype} alt="" aria-hidden="true" />
        <span>{branding.name}</span>
      </div>

      <ul class="integration-tools integration-tools--destinations">
        {
          destinations.map((tool, index) => (
            <li
              class="integration-tool"
              style={`--tool-delay: ${270 + index * 90}ms; --tool-accent: ${tool.accent}`}
            >
              <span class="integration-tool__icon-wrap">
                <Icon
                  name={tool.icon}
                  class="integration-tool__icon"
                  aria-hidden="true"
                />
              </span>
              <span>{tool.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .integration-map {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(8rem, 1fr) minmax(8rem, 1fr) minmax(
        8rem,
        1fr
      );
    align-items: center;
    gap: clamp(1rem, 4vw, 4.5rem);
    min-height: 19.5rem;
    padding: clamp(1rem, 3vw, 2rem);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--primary) 18%, var(--muted));
    border-radius: 2rem;
    background:
      radial-gradient(
        circle at 50% 50%,
        color-mix(in srgb, var(--primary) 8%, transparent),
        transparent 30%
      ),
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--background) 94%, white),
        color-mix(in srgb, var(--primary) 4%, var(--background))
      );
    box-shadow:
      var(--shadow-pastel),
      inset 0 1px 0 rgb(255 255 255 / 0.7);
  }

  .integration-map::before {
    position: absolute;
    inset: 0.5rem;
    z-index: -1;
    border: 1px solid color-mix(in srgb, var(--primary) 8%, transparent);
    border-radius: 1.55rem;
    content: "";
    pointer-events: none;
  }

  .integration-map::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 15rem;
    height: 15rem;
    z-index: -1;
    border-radius: 50%;
    background: color-mix(in srgb, var(--brand-lime) 12%, transparent);
    filter: blur(2rem);
    content: "";
    opacity: 0.45;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .integration-map__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: color-mix(in srgb, var(--primary) 32%, var(--muted));
    pointer-events: none;
    z-index: 0;
  }

  .integration-map__lines path {
    stroke: url("#integration-line-gradient");
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-dasharray: 1 7;
    animation: integration-line-flow 3.6s linear infinite;
  }

  .integration-map__lines path:nth-child(3n + 2) {
    animation-delay: -1.2s;
  }

  .integration-map__lines path:nth-child(3n) {
    animation-delay: -2.4s;
  }

  .integration-tools {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .integration-tools--sources {
    justify-items: start;
  }

  .integration-tools--destinations {
    justify-items: end;
  }

  .integration-tool {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 8.9rem;
    padding: 0.7rem 0.8rem;
    border: 1px solid color-mix(in srgb, var(--foreground) 10%, var(--muted));
    border-radius: 0.9rem;
    background: color-mix(in srgb, var(--background) 92%, white);
    box-shadow:
      var(--shadow-pastel-sm),
      inset 0 1px 0 rgb(255 255 255 / 0.8);
    color: var(--foreground);
    font-size: 0.76rem;
    font-weight: 700;
    line-height: 1.1;
    animation: integration-tool-enter 480ms cubic-bezier(0.22, 1, 0.36, 1)
      var(--tool-delay) both;
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .integration-tool:hover {
    border-color: color-mix(in srgb, var(--tool-accent) 38%, var(--muted));
    box-shadow: 0 0.75rem 1.5rem
      color-mix(in srgb, var(--tool-accent) 12%, transparent);
    transform: translateY(-0.15rem);
  }

  .integration-tool__icon-wrap {
    display: grid;
    width: 1.8rem;
    height: 1.8rem;
    flex: none;
    place-items: center;
    border-radius: 0.55rem;
    background: color-mix(in srgb, var(--tool-accent) 10%, var(--background));
    color: var(--tool-accent);
  }

  .integration-tool__icon {
    width: 1rem;
    height: 1rem;
  }

  .integration-center {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    justify-self: center;
    width: clamp(6.75rem, 12vw, 8.25rem);
    aspect-ratio: 1;
    border-radius: 1.4rem;
    background: linear-gradient(
      145deg,
      color-mix(in srgb, var(--primary) 92%, white),
      var(--primary)
    );
    box-shadow:
      0 1.25rem 2.5rem color-mix(in srgb, var(--primary) 28%, transparent),
      0 0 0 0.45rem color-mix(in srgb, var(--primary) 8%, transparent);
    color: var(--background);
  }

  .integration-center::before {
    position: absolute;
    inset: 0.45rem;
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 1.05rem;
    content: "";
    pointer-events: none;
  }

  .integration-center__status {
    position: absolute;
    top: -1.35rem;
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    color: color-mix(in srgb, var(--primary) 68%, var(--foreground));
    font-size: 0.55rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .integration-center__status i {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: #55c878;
    box-shadow: 0 0 0 0.2rem color-mix(in srgb, #55c878 20%, transparent);
  }

  .integration-center img {
    width: 2.3rem;
    height: 2.3rem;
    filter: brightness(0) invert(1);
  }

  .integration-center span {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  @keyframes integration-tool-enter {
    from {
      opacity: 0;
      transform: translateY(0.65rem) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes integration-line-flow {
    to {
      stroke-dashoffset: -16;
    }
  }

  @media (max-width: 640px) {
    .integration-map {
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      min-height: auto;
      padding: 1rem;
    }

    .integration-map__lines {
      display: none;
    }

    .integration-center {
      grid-column: 1 / -1;
      grid-row: 1;
      width: 6.75rem;
      margin-bottom: 0.3rem;
    }

    .integration-tools {
      gap: 0.65rem;
    }

    .integration-tools--sources {
      grid-column: 1;
      grid-row: 2;
    }

    .integration-tools--destinations {
      grid-column: 2;
      grid-row: 2;
    }

    .integration-tool {
      min-width: 0;
      width: 100%;
      padding: 0.6rem;
      gap: 0.45rem;
      font-size: 0.68rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .integration-tool,
    .integration-map__lines path {
      animation: none;
    }
  }
</style>
