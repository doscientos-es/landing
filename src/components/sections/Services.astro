---
import { Award, Code, Lock, Rocket, Smartphone, Users } from "@lucide/astro";
import { Image } from "astro:assets";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import CtaButton from "../ui/CtaButton.astro";

import imageMobile from "~/assets/media/landing/flatmatch-mobile.webp";
import imageFooter from "~/assets/media/landing/nh-admin.webp";
import imagePhones from "~/assets/media/landing/phones.webp";

const services = [
  {
    title: "Todo tu negocio en una herramienta, no en diez Excel",
    description:
      "Clientes, pedidos, facturas y stock en un sistema hecho exactamente para tu proceso. Sin licencias por usuario, sin adaptar cómo trabajas a Salesforce o HubSpot.",
  },
  {
    title: "De idea a producción en 6 semanas",
    description:
      "Marketplaces, herramientas B2B, apps de reservas, gestión interna. Lanzamos lo mínimo viable con usuarios reales mientras tu competencia sigue en Figma.",
  },
  {
    title: "El trabajo que tu equipo repite cada semana, automatizado",
    description:
      "Conectamos tienda, ERP y contabilidad. Los pedidos entran solos, las facturas salen cumpliendo VeriFactu y el informe llega sin que nadie lo prepare. ROI en 2-3 meses.",
  },
  {
    title: "Ese Access o Excel de hace 10 años te cuesta dinero cada semana",
    description:
      "Lo sustituimos sin parar la operativa. Mientras construimos el nuevo, el antiguo sigue funcionando. Tus clientes no notan nada, tú sí.",
  },
  {
    title: "Preparado para cuando crezcas ×10",
    description:
      "Arquitectura que no te frena cuando llegas a 10.000 usuarios.",
  },
];

const benefits = [
  {
    label: "Precio fijo desde día 1",
    icon: Lock,
  },
  {
    label: "En producción en 6 semanas",
    icon: Rocket,
  },
  {
    label: "Demo semanal",
    icon: Smartphone,
  },
  {
    label: "El código es tuyo",
    icon: Code,
  },
  {
    label: "Sin cuotas por usuario",
    icon: Users,
  },
  {
    label: "Ingenieros senior",
    icon: Award,
  },
];
---

<section class="services-bento relative overflow-hidden bg-[#202120] px-4 py-20 text-white sm:px-6 lg:py-28">
  <div class="relative z-10 mx-auto max-w-7xl">
    <header class="mx-auto mb-12 max-w-2xl text-center">
      <h2 class="text-balance text-3xl font-bold tracking-tight sm:text-4xl">Menos tareas manuales, más negocio.</h2>
      <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-white/60">Backoffices, CRMs y automatizaciones a medida para que tu equipo trabaje mejor desde el primer día.</p>
    </header>

    <ul class="grid gap-4 lg:grid-cols-6">
      <li class="service-card lg:col-span-2" data-reveal="top-left">
        <h3>{services[0].title}</h3>
        <p>{services[0].description}</p>
        <Image src={imagePhones} alt="Apps móviles a medida para gestionar clientes y pedidos" loading="lazy" decoding="async" class="service-card-image aspect-[16/10] object-cover object-top" />
        <div class="service-tags"><span>CRM</span><span>Operaciones</span><span>Software a medida</span></div>
      </li>
      <li class="service-card lg:col-span-4" data-reveal="top-right">
        <h3>{services[1].title}</h3>
        <p>{services[1].description}</p>
        <ol class="service-process" aria-label="Proceso de lanzamiento">
          <li><span>01</span><strong>Entender</strong><small>El problema real</small></li>
          <li><span>02</span><strong>Construir</strong><small>Lo que hace falta</small></li>
          <li><span>03</span><strong>Lanzar</strong><small>Con usuarios reales</small></li>
        </ol>
        <ul class="service-tags">{benefits.map((step) => { const IconComponent = step.icon; return <li><IconComponent class="size-3.5" />{step.label}</li>; })}</ul>
      </li>
      <li class="service-card lg:col-span-4" data-reveal="right">
        <div class="grid gap-6 md:grid-cols-[1.4fr_0.8fr] md:items-end">
          <div><h3>{services[2].title}</h3><p>{services[2].description}</p><CtaButton size="sm" /></div>
          <Image src={imageMobile} alt="App móvil de Flatmatch mostrando un flujo de búsqueda" loading="lazy" decoding="async" class="mx-auto max-h-[220px] w-full rounded-t-[28px] border-4 border-b-0 border-white/20 bg-white/10 p-1 object-cover object-top" />
        </div>
      </li>
      <li class="service-card lg:col-span-2" data-reveal="bottom-right">
        <h3>{services[4].title}</h3><p>{services[4].description}</p><CtaButton size="sm" />
      </li>
      <li class="service-card lg:col-span-6" data-reveal="bottom-left">
        <div class="grid gap-6 md:grid-cols-[1fr_1.35fr] md:items-end"><div><h3>{services[3].title}</h3><p>{services[3].description}</p></div><Image src={imageFooter} alt="Panel de administración a medida" loading="lazy" decoding="async" class="service-card-image aspect-[16/6] object-cover object-top" /></div>
      </li>
    </ul>
  </div>
</section>

<style>
  .services-bento::before { content: ""; position: absolute; inset: 0; opacity: .16; background-image: linear-gradient(rgba(255,255,255,.08) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.08) 1px, transparent 1px); background-size: 72px 72px; mask-image: linear-gradient(to bottom, black, transparent 85%); }
  .service-card { display: flex; min-height: 270px; flex-direction: column; gap: 1rem; border-radius: 1.25rem; background: #2b2c2b; padding: 1.5rem; box-shadow: inset 0 1px rgba(255,255,255,.05); }
  .service-card h3 { max-width: 32rem; font-size: clamp(1.25rem, 2vw, 1.75rem); font-weight: 700; line-height: 1.08; letter-spacing: -.025em; }
  .service-card p { max-width: 42rem; color: rgba(255,255,255,.62); line-height: 1.65; }
  .service-card-image { margin-top: auto; width: 100%; border-radius: .9rem; opacity: .9; }
  .service-tags { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: auto; }
  .service-tags span, .service-tags li { display: inline-flex; align-items: center; gap: .4rem; border-radius: 999px; background: rgba(0,0,0,.28); padding: .4rem .7rem; color: rgba(255,255,255,.78); font-size: .7rem; font-weight: 600; }
  .service-process { display: grid; grid-template-columns: repeat(3, 1fr); gap: .75rem; margin-top: auto; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,.1); }
  .service-process li { display: flex; min-width: 0; flex-direction: column; gap: .15rem; }
  .service-process span { color: rgba(255,255,255,.38); font-size: .7rem; font-weight: 700; }
  .service-process strong { font-size: .95rem; }
  .service-process small { color: rgba(255,255,255,.5); font-size: .72rem; }
  @media (max-width: 640px) { .service-card { min-height: 0; padding: 1.25rem; } }
</style>
