---
import { ArrowUpRight, BadgeCheck, ShieldCheck, Sparkles } from "@lucide/astro";
import npmDownloads from "~/data/npm-downloads.json";

const downloads = new Intl.NumberFormat("es-ES").format(
  npmDownloads.totals.downloads,
);

const benefits = [
  {
    icon: ShieldCheck,
    title: "Base técnica mantenida",
    description:
      "Partimos de componentes propios para lo repetible, en lugar de improvisar las partes críticas en cada proyecto.",
  },
  {
    icon: BadgeCheck,
    title: "Nada es una caja negra",
    description:
      "Documentamos decisiones y mantenemos una parte de nuestras bases abierta para que pueda revisarse.",
  },
  {
    icon: Sparkles,
    title: "A medida donde importa",
    description:
      "Tu operativa, integraciones y ventajas de negocio se diseñan específicamente para tu empresa.",
  },
];
---

<section id="open-source" class="landing-section py-[clamp(3rem,8vw,7rem)]">
  <div
    class="mx-auto grid w-full max-w-6xl grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] items-center gap-[clamp(2rem,7vw,7rem)] max-[800px]:grid-cols-1 max-[800px]:gap-10"
  >
    <div class="max-w-[34rem]" data-stagger="100">
      <h2
        class="m-0 max-w-[13ch] text-[clamp(2.25rem,4vw,4.25rem)] font-extrabold leading-[0.96] tracking-[-0.065em] text-foreground text-balance max-[800px]:max-w-[15ch]"
        data-reveal="bottom"
        data-speed="normal"
        data-easing="smooth"
      >
        No empezamos de cero donde no aporta valor.
      </h2>
      <p
        class="m-0 max-w-[31rem] text-base leading-[1.65] text-muted-foreground"
        data-reveal="bottom"
        data-speed="normal"
        data-easing="soft"
      >
        Construimos lo específico de tu negocio a medida. Para lo repetible,
        partimos de componentes propios, mantenidos y abiertos.
      </p>
      <p
        class="mt-7 flex w-fit items-baseline gap-[0.7rem] border-t border-t-[color-mix(in_srgb,var(--foreground)_14%,transparent)] pt-4 max-[480px]:w-full"
        data-reveal="bottom"
        data-speed="fast"
      >
        <strong
          class="text-[clamp(2rem,3vw,2.75rem)] font-extrabold leading-[0.9] tracking-[-0.06em] text-primary"
        >
          {downloads}
        </strong>
        <span
          class="max-w-56 text-[0.72rem] font-bold leading-[1.35] text-muted-foreground"
        >
          descargas acumuladas de nuestras herramientas abiertas
        </span>
      </p>
      <a
        href="/open-source"
        class="mt-6 inline-flex items-center gap-[0.45rem] rounded-full border border-[color-mix(in_srgb,var(--foreground)_14%,transparent)] px-[0.9rem] py-[0.7rem] text-[0.88rem] font-[750] text-foreground no-underline transition-[background-color,border-color,color] duration-200 hover:border-primary hover:bg-[color-mix(in_srgb,var(--primary)_8%,var(--background))] hover:text-primary focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-[3px] [&_svg]:transition-transform [&:hover_svg]:translate-x-[0.14rem] [&:hover_svg]:-translate-y-[0.14rem]"
        data-reveal="bottom"
        data-speed="fast"
        data-easing="soft"
      >
        Conocer nuestra base técnica <ArrowUpRight
          class="size-4"
          aria-hidden="true"
        />
      </a>
    </div>

    <div class="open-source-panel" data-stagger="100">
      <div
        class="open-source-principle"
        data-reveal="bottom"
        data-easing="smooth"
      >
        <p
          class="m-0 max-w-[23rem] text-[clamp(1.45rem,2.4vw,2rem)] font-bold leading-[1.04] tracking-[-0.04em] text-background text-balance"
        >
          Estándar donde da seguridad. A medida donde da ventaja.
        </p>
      </div>
      <ul class="open-source-benefits">
        {
          benefits.map(({ icon: Icon, title, description }, index) => (
            <li data-reveal="bottom" data-speed="normal" data-easing="soft">
              <span class="open-source-benefit-number" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="open-source-icon">
                <Icon class="size-5" aria-hidden="true" />
              </span>
              <div>
                <h3>{title}</h3>
                <p>{description}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <p
        class="m-0 border-t-[color-mix(in_srgb,var(--background)_12%,transparent)] bg-[color-mix(in_srgb,var(--background)_3%,transparent)] px-[clamp(1.5rem,4vw,2.5rem)] py-[1.2rem] text-[0.68rem] font-[750] uppercase tracking-[0.1em] text-[color-mix(in_srgb,var(--background)_62%,transparent)]"
        data-reveal="bottom"
        data-speed="fast"
      >
        Para equipos técnicos: código, documentación y paquetes públicos
        disponibles.
      </p>
    </div>
  </div>
</section>

<style>
  .open-source-panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--foreground) 12%, transparent);
    border-radius: 1.75rem;
    background: var(--foreground);
    box-shadow:
      var(--shadow-pastel),
      0 1.5rem 3rem color-mix(in srgb, var(--foreground) 12%, transparent);
  }
  .open-source-panel::before {
    position: absolute;
    top: -7rem;
    right: -4rem;
    z-index: -1;
    width: 16rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: color-mix(in srgb, var(--primary) 45%, transparent);
    content: "";
    filter: blur(2rem);
    opacity: 0.7;
  }
  .open-source-principle {
    position: relative;
    padding: clamp(1.75rem, 4vw, 2.75rem) clamp(1.5rem, 4vw, 2.5rem);
    border-bottom: 1px solid
      color-mix(in srgb, var(--background) 12%, transparent);
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--primary) 40%, var(--foreground)),
      color-mix(in srgb, var(--primary) 12%, var(--foreground))
    );
  }
  .open-source-benefits {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .open-source-benefits li {
    display: grid;
    grid-template-columns: 1.5rem auto minmax(0, 1fr);
    gap: 0.85rem;
    padding: 1.35rem clamp(1.5rem, 4vw, 2.5rem);
    transition: background-color 180ms ease;
  }
  .open-source-benefits li:hover {
    background: color-mix(in srgb, var(--background) 4%, transparent);
  }
  .open-source-benefit-number {
    padding-top: 0.18rem;
    color: color-mix(in srgb, var(--background) 38%, transparent);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }
  .open-source-icon {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--background) 11%, transparent);
    color: var(--background);
  }
  .open-source-benefits h3 {
    margin: 0;
    color: var(--background);
    font-size: 1rem;
    font-weight: 750;
  }
  .open-source-benefits p {
    margin: 0.35rem 0 0;
    color: color-mix(in srgb, var(--background) 68%, transparent);
    font-size: 0.8rem;
    line-height: 1.6;
  }
  @media (max-width: 800px) {
    .open-source-panel {
      max-width: 38rem;
    }
  }
  @media (max-width: 480px) {
    .open-source-benefits li {
      grid-template-columns: auto 1fr;
      column-gap: 0.8rem;
    }
    .open-source-benefit-number {
      display: none;
    }
  }
</style>
