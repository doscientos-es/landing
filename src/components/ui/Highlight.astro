---
type Props = {
  label: string;
  value: string;
};
const { label, value } = Astro.props;
---

<li class="highlight-card flex min-h-[92px] items-center gap-3 rounded-3xl border border-muted/70 bg-muted/70 p-3">
  <i
    class="grid size-11 shrink-0 place-items-center rounded-2xl bg-background"
  >
    <slot />
  </i>
  <div class="flex min-w-0 flex-col gap-1 pr-2">
    <span class="text-[10px] font-medium uppercase tracking-[0.08em] text-muted-foreground">
      {label}
    </span>
    <span class="text-sm leading-snug text-foreground">
      {value}
    </span>
  </div>
</li>
