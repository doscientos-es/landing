---
import { copy } from "~/shared/lib/copy";
---

<div
  class="relative z-20 max-w-5xl mx-auto px-6 pt-3 pb-5 md:pt-4 md:pb-6"
  data-reveal="bottom"
  data-speed="normal"
  data-easing="soft"
  data-delay="700"
>
  <div
    class="mx-auto flex w-fit max-w-full items-center justify-center gap-5 border-y border-y-[color-mix(in_srgb,var(--foreground)_10%,transparent)] py-3 text-muted-foreground max-[639px]:w-full max-[639px]:justify-between max-[639px]:gap-[0.7rem]"
    aria-label="Pruebas de confianza"
  >
    <div
      class="flex items-baseline gap-[0.45rem] whitespace-nowrap max-[639px]:flex-col max-[639px]:items-center max-[639px]:gap-1 max-[639px]:whitespace-normal max-[639px]:text-center"
    >
      <strong class="text-[1.1rem] leading-none text-foreground">+30</strong>
      <span class="text-[0.72rem] leading-[1.25] max-[639px]:max-w-[6.5rem]"
        >proyectos entregados</span
      >
    </div>
    <span
      class="h-[1.1rem] w-px bg-[color-mix(in_srgb,var(--foreground)_14%,transparent)]"
      aria-hidden="true"></span>
    <div
      class="flex items-baseline gap-[0.45rem] whitespace-nowrap max-[639px]:flex-col max-[639px]:items-center max-[639px]:gap-1 max-[639px]:whitespace-normal max-[639px]:text-center"
    >
      <strong class="text-[1.1rem] leading-none text-foreground">6 sem</strong>
      <span class="text-[0.72rem] leading-[1.25] max-[639px]:max-w-[6.5rem]"
        >plazo habitual MVP</span
      >
    </div>
    <span
      class="h-[1.1rem] w-px bg-[color-mix(in_srgb,var(--foreground)_14%,transparent)]"
      aria-hidden="true"></span>
    <div
      class="flex items-baseline gap-[0.45rem] whitespace-nowrap max-[639px]:flex-col max-[639px]:items-center max-[639px]:gap-1 max-[639px]:whitespace-normal max-[639px]:text-center"
    >
      <strong class="text-[1.1rem] leading-none text-foreground">-90%</strong>
      <span class="text-[0.72rem] leading-[1.25] max-[639px]:max-w-[6.5rem]"
        >de tiempo en procesos manuales</span
      >
    </div>
  </div>
  <ul
    class="mt-4 flex flex-wrap justify-center gap-x-[1.1rem] gap-y-[0.4rem] text-[0.72rem] font-semibold text-muted-foreground max-[639px]:flex-col max-[639px]:items-center max-[639px]:gap-[0.45rem]"
    aria-label="Condiciones de trabajo"
  >
    {
      copy.hero.highlights.map((highlight) => (
        <li class="inline-flex items-center gap-[0.35rem] before:size-[0.35rem] before:rounded-full before:bg-primary before:content-['']">
          {highlight}
        </li>
      ))
    }
  </ul>
</div>
