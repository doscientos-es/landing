---
import { Calendar } from "@lucide/astro";

interface Props {
  diagnosticHref: string;
  bookingHref: string;
  home?: boolean;
}

const { diagnosticHref, bookingHref, home = false } = Astro.props;
---

<a
  href={diagnosticHref}
  id={home ? "hero-cta-primary" : undefined}
  class="hero-cta hero-cta--primary w-full sm:w-auto"
>
  <Calendar class="size-3.5" aria-hidden="true" />
  Pedir diagnóstico gratis
</a>
<a
  href={bookingHref}
  id={home ? "hero-cta-secondary" : undefined}
  data-cal-booking={home ? true : undefined}
  data-cal-booking-placement={home ? "home_hero" : undefined}
  data-cal-booking-ref={home ? "home-hero" : undefined}
  class="hero-cta hero-cta--secondary w-full sm:w-auto"
  target={home ? "_blank" : undefined}
  rel={home ? "noopener noreferrer" : undefined}
>
  <svg
    aria-hidden="true"
    class="h-3.5 w-auto shrink-0"
    viewBox="0 0 87.5 72"
    fill="none"
  >
    <path
      fill="#00832d"
      d="M49.5 36l8.53 9.75 11.47 7.33 2-17.02-2-16.64-11.69 6.44z"></path>
    <path
      fill="#0066da"
      d="M0 51.5V66c0 3.315 2.685 6 6 6h14.5l3-10.96-3-9.54-9.95-3z"></path>
    <path fill="#e94235" d="M20.5 0L0 20.5l10.55 3 9.95-3 2.95-9.41z"></path>
    <path fill="#2684fc" d="M20.5 20.5H0v31h20.5z"></path>
    <path
      fill="#00ac47"
      d="M82.6 8.68L69.5 19.42v33.66l13.16 10.79c1.97 1.54 4.85.135 4.85-2.37V11c0-2.535-2.945-3.925-4.91-2.32zM49.5 36v15.5h-29V72h43c3.315 0 6-2.685 6-6V53.08z"
    ></path>
    <path
      fill="#ffba00"
      d="M63.5 0h-43v20.5h29V36l20-16.57V6c0-3.315-2.685-6-6-6z"></path>
  </svg>
  Agendar videollamada
</a>

<style>
  .hero-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 2.85rem;
    padding: 0.7rem 1rem;
    border-radius: 9999px;
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      background-color 180ms ease;
  }
  .hero-cta:hover {
    transform: translateY(-1px);
  }
  .hero-cta:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 3px;
  }
  .hero-cta--primary {
    background: var(--foreground);
    box-shadow: 0 8px 20px
      color-mix(in srgb, var(--foreground) 14%, transparent);
    color: var(--background);
  }
  .hero-cta--primary:hover {
    background: color-mix(in srgb, var(--foreground) 91%, var(--background));
    box-shadow: 0 10px 24px
      color-mix(in srgb, var(--foreground) 18%, transparent);
  }
  .hero-cta--secondary {
    background: var(--background);
    box-shadow: 0 6px 18px color-mix(in srgb, var(--foreground) 8%, transparent);
    color: var(--foreground);
  }
  .hero-cta--secondary:hover {
    background: color-mix(in srgb, var(--foreground) 4%, var(--background));
  }
  @media (min-width: 640px) {
    .hero-cta {
      gap: 0.45rem;
      min-height: 2.3rem;
      padding: 0.52rem 0.8rem;
      font-size: 0.78rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-cta {
      transition: none;
    }
    .hero-cta:hover {
      transform: none;
    }
  }
</style>
