---
import { branding } from "~/config/branding";
import { diagnosticRoute, headerNavItems } from "~/data/commercialRoutes";
import UpRightArrow from "~/components/ui/UpRightArrow.astro";

const desktopNavItems = headerNavItems;
const mobileNavItems = [{ href: "/", label: "Inicio" }, ...desktopNavItems];

const pathname = Astro.url.pathname;
---

<header
  data-reveal="top"
  class="site-nav fixed top-6 left-1/2 z-50 flex w-[calc(100vw-2rem)] max-w-[90vw] -translate-x-1/2 items-center justify-between gap-2 lg:w-fit lg:justify-center lg:gap-3"
>
  <a
    id="nav-home-link"
    href="/"
    aria-label={branding.name}
    class="nav-pill flex size-9 shrink-0 cursor-pointer items-center justify-center hover:opacity-80 transition-opacity"
  >
    <div id="nav-logo-iso" class="flex size-5 items-center justify-center">
      <img
        src={branding.assets.isotype}
        alt={branding.name}
        class="h-5 w-auto object-contain"
      />
    </div>
  </a>

  <nav
    class="nav-pill hidden items-center gap-0 lg:flex"
    aria-label="Navegación principal"
  >
    {
      desktopNavItems.map((item) => {
        const isActive =
          pathname === item.href ||
          (item.href !== "/" && pathname.startsWith(item.href));
        return (
          <a
            href={item.href}
            aria-current={isActive ? "page" : undefined}
            class={`rounded-full px-3.5 py-2.5 text-sm leading-none font-medium transition-colors ${isActive ? "text-foreground" : "text-muted-foreground hover:text-foreground"}`}
          >
            {item.label}
          </a>
        );
      })
    }
  </nav>

  <button
    id="mobile-menu-button"
    class="nav-pill flex size-10 items-center justify-center text-foreground transition-colors hover:bg-background/85 lg:hidden"
    aria-label="Abrir menú"
    aria-controls="mobile-menu"
    aria-expanded="false"
  >
    <svg
      id="hamburger-icon"
      class="size-6"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <line id="bar-top" x1="4" y1="6" x2="20" y2="6"></line>
      <line id="bar-mid" x1="4" y1="12" x2="20" y2="12"></line>
      <line id="bar-bot" x1="4" y1="18" x2="20" y2="18"></line>
    </svg>
  </button>

  <div id="nav-cta" class="hidden items-center lg:flex">
    <a
      href={`${diagnosticRoute.href}?ref=nav-cta`}
      class="flex items-center gap-2 rounded-full bg-foreground px-4 py-1.5 text-sm leading-none font-medium whitespace-nowrap text-background shadow-pastel-sm transition-all hover:bg-foreground/90 hover:shadow-xl"
    >
      Diagnóstico gratis
      <UpRightArrow inverted />
    </a>
  </div>
</header>

<div
  id="mobile-menu"
  class="fixed inset-0 z-40 lg:hidden bg-background/95 backdrop-blur-md pointer-events-none opacity-0 transition-opacity duration-300"
  role="dialog"
  aria-label="Navegación principal"
  aria-hidden="true"
  inert
>
  <nav
    class="flex flex-col items-center justify-center h-full gap-8"
    aria-label="Navegación móvil"
  >
    {
      mobileNavItems.map((item, i) => {
        const isActive =
          pathname === item.href ||
          (item.href !== "/" && pathname.startsWith(item.href));
        return (
          <a
            href={item.href}
            aria-current={isActive ? "page" : undefined}
            class={`mobile-menu-link text-2xl font-medium transition-colors translate-y-4 opacity-0 ${isActive ? "text-primary underline" : "text-foreground hover:text-primary"}`}
            style={`transition: opacity 300ms ${80 + i * 60}ms, transform 300ms ${80 + i * 60}ms;`}
          >
            {item.label}
          </a>
        );
      })
    }
    <a
      href={`${diagnosticRoute.href}?ref=mobile-nav-cta`}
      class="mobile-menu-link translate-y-4 opacity-0"
      style={`transition: opacity 300ms ${80 + mobileNavItems.length * 60}ms, transform 300ms ${80 + mobileNavItems.length * 60}ms;`}
    >
      <Button size="lg" withArrow> Diagnóstico gratis </Button>
    </a>
  </nav>
</div>

<script>
  let cleanupNavbar: (() => void) | undefined;

  function initNavbar() {
    cleanupNavbar?.();
    const controller = new AbortController();
    const { signal } = controller;
    const menuButton = document.getElementById("mobile-menu-button");
    const mobileMenu = document.getElementById("mobile-menu");
    const homeLink = document.getElementById("nav-home-link");
    const barTop = document.getElementById("bar-top") as SVGLineElement | null;
    const barMid = document.getElementById("bar-mid") as SVGLineElement | null;
    const barBot = document.getElementById("bar-bot") as SVGLineElement | null;

    let isOpen = false;
    let scrollPosition = 0;

    function lockPageScroll() {
      scrollPosition = window.scrollY;
      document.documentElement.style.overflow = "hidden";
      document.body.style.position = "fixed";
      document.body.style.top = `-${scrollPosition}px`;
      document.body.style.width = "100%";
      document.body.style.overflow = "hidden";
      homeLink?.classList.add("pointer-events-none");
      homeLink?.setAttribute("aria-hidden", "true");
    }

    function unlockPageScroll() {
      document.documentElement.style.overflow = "";
      document.body.style.position = "";
      document.body.style.top = "";
      document.body.style.width = "";
      document.body.style.overflow = "";
      homeLink?.classList.remove("pointer-events-none");
      homeLink?.removeAttribute("aria-hidden");
      window.scrollTo(0, scrollPosition);
    }

    function openMenu() {
      isOpen = true;
      mobileMenu?.classList.remove("opacity-0", "pointer-events-none");
      mobileMenu?.classList.add("opacity-100");
      menuButton?.setAttribute("aria-expanded", "true");
      menuButton?.setAttribute("aria-label", "Cerrar menú");
      mobileMenu?.setAttribute("aria-hidden", "false");
      mobileMenu?.removeAttribute("inert");
      lockPageScroll();

      if (barTop) barTop.style.transform = "translateY(6px) rotate(45deg)";
      if (barMid) {
        barMid.style.opacity = "0";
        barMid.style.transform = "scaleX(0)";
      }
      if (barBot) barBot.style.transform = "translateY(-6px) rotate(-45deg)";

      mobileMenu
        ?.querySelectorAll<HTMLElement>(".mobile-menu-link")
        .forEach((el) => {
          el.style.opacity = "1";
          el.style.transform = "translateY(0)";
        });

      setTimeout(() => {
        const first = mobileMenu?.querySelector<HTMLElement>("a, button");
        first?.focus();
      }, 80);
    }

    function closeMenu() {
      isOpen = false;
      mobileMenu?.classList.add("opacity-0", "pointer-events-none");
      mobileMenu?.classList.remove("opacity-100");
      menuButton?.setAttribute("aria-expanded", "false");
      menuButton?.setAttribute("aria-label", "Abrir menú");
      mobileMenu?.setAttribute("aria-hidden", "true");
      mobileMenu?.setAttribute("inert", "");
      unlockPageScroll();

      if (barTop) barTop.style.transform = "";
      if (barMid) {
        barMid.style.opacity = "1";
        barMid.style.transform = "";
      }
      if (barBot) barBot.style.transform = "";

      mobileMenu
        ?.querySelectorAll<HTMLElement>(".mobile-menu-link")
        .forEach((el) => {
          el.style.opacity = "0";
          el.style.transform = "translateY(1rem)";
        });

      menuButton?.focus();
    }

    mobileMenu?.addEventListener(
      "keydown",
      (e: KeyboardEvent) => {
        if (!isOpen) return;
        const focusable = Array.from(
          mobileMenu.querySelectorAll<HTMLElement>(
            "a, button, [tabindex]:not([tabindex='-1'])",
          ),
        );
        const first = focusable[0];
        const last = focusable[focusable.length - 1];

        if (e.key === "Escape") {
          closeMenu();
          return;
        }
        if (e.key !== "Tab") return;

        if (e.shiftKey) {
          if (document.activeElement === first) {
            last.focus();
            e.preventDefault();
          }
        } else {
          if (document.activeElement === last) {
            first.focus();
            e.preventDefault();
          }
        }
      },
      { signal },
    );

    menuButton?.addEventListener(
      "click",
      () => {
        if (isOpen) closeMenu();
        else openMenu();
      },
      { signal },
    );
    document.querySelectorAll(".mobile-menu-link").forEach((link) => {
      link.addEventListener("click", closeMenu, { signal });
    });

    cleanupNavbar = () => {
      controller.abort();
      if (isOpen) unlockPageScroll();
    };
  }

  document.addEventListener("astro:page-load", initNavbar);
</script>

<style>
  .site-nav {
    background: transparent;
  }

  .nav-pill {
    border: 1px solid rgb(35 35 35 / 0.06);
    background: #fff;
    border-radius: 9999px;
    box-shadow: var(--shadow-pastel-sm);
    backdrop-filter: blur(24px);
  }

  #bar-top,
  #bar-mid,
  #bar-bot {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
  }
</style>
